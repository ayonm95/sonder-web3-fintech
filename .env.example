# ==============================================================================
# SONDER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your real `.env` file containing private keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance.
# Example for Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sonder_music"

# ------------------------------------------------------------------------------
# 2. Application & API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="your-32-byte-ultra-secure-jwt-secret-key-change-this-in-production"

# ------------------------------------------------------------------------------
# 3. Polygon Amoy Testnet (Web3 & Smart Contracts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POLYGON_CHAIN_ID="80002"

# Reliable Public Amoy RPC endpoint:
NEXT_PUBLIC_POLYGON_RPC="https://polygon-amoy.drpc.org"
AMOY_RPC_URL="https://polygon-amoy.drpc.org"

# Deployed Smart Contract Addresses on Polygon Amoy (80002):
# SettlementManager: Commits royalty period Merkle roots on-chain
NEXT_PUBLIC_SETTLEMENT_MANAGER_ADDRESS="0xCc5A9aB4A844BF89a972F7Fb5830F0c2027a689b"

# CreatorRegistry: Manages canonical creator ID hashes and payout wallets
NEXT_PUBLIC_CREATOR_REGISTRY_ADDRESS="0xc84edECB4DA294756Ac03B696F3e3f9ae78D5000"

# CreatorClaims (Optional / Multi-contract architecture)
NEXT_PUBLIC_CREATOR_CLAIMS_ADDRESS="0xb61136b637f5d6fF87123A11C238622c83c27f51"

# ------------------------------------------------------------------------------
# 4. Backend Operator Wallet (Server-Side Automated Commitments)
# ------------------------------------------------------------------------------
# The public address of the operator wallet (used as constructor args during deployment)
WALLET_ADDRESS="0x65371f0ddFa0AD6e7655243cD2A2567328EA1537"

# Raw private key (64 hex characters, without 0x prefix) of the operator wallet.
# This wallet pays gas fees on Polygon Amoy when committing Merkle roots.
# MUST BE FUNDED WITH TESTNET POL (from https://faucet.polygon.technology)
PRIVATE_KEY="your_operator_private_key_without_0x_prefix"
